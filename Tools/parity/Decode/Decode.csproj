<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <Description>Decodes a directory of samples to PPM, so the parity report can compare our reading of them against the third-party tools' on equal terms.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Hawkynt.FileFormats.Images\Hawkynt.FileFormats.Images.csproj" />
    <!-- Containers and codecs live in their own registry, so measuring them takes their own
         reference. Without it this tool goes blind to every video format the moment one exists. -->
    <ProjectReference Include="..\..\..\Hawkynt.FileFormats.Video\Hawkynt.FileFormats.Video.csproj" />
    <ProjectReference Include="..\..\..\FileFormat.Core\FileFormat.Core.csproj" />
  </ItemGroup>
</Project>
