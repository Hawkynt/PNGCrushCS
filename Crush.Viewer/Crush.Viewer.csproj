<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Description>Image viewer supporting 500+ formats with zoom, pan, multi-image navigation, and format conversion.</Description>
    <!-- Publish settings only apply on Windows. Linux CI (compile-only) skips them so the
         WindowsForms runtime pack isn't required for the linux-x64 RID. -->
    <PublishSingleFile Condition="'$(OS)' == 'Windows_NT'">true</PublishSingleFile>
    <!-- WinForms is not compatible with trimming (NETSDK1175) -->
    <SelfContained Condition="'$(OS)' == 'Windows_NT'">true</SelfContained>
    <EnableCompressionInSingleFile Condition="'$(OS)' == 'Windows_NT'">true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(OS)' == 'Windows_NT'">true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Optimizers\Optimizer.Image\Optimizer.Image.csproj" />
    <ProjectReference Include="..\FileFormat.Core\FileFormat.Core.csproj" />
    <ProjectReference Include="..\Hawkynt.ImageTransformUI\Hawkynt.ImageTransformUI.csproj" />
  </ItemGroup>

</Project>
