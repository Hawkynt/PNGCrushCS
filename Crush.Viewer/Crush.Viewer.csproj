<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Cross-platform image browser, viewer, converter, and page assembler for the PNGCrushCS format suite.</Description>
    <PublishSingleFile Condition="'$(OS)' == 'Windows_NT'">true</PublishSingleFile>
    <SelfContained Condition="'$(OS)' == 'Windows_NT'">true</SelfContained>
    <RuntimeIdentifier Condition="'$(OS)' == 'Windows_NT' And '$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile Condition="'$(OS)' == 'Windows_NT'">true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(OS)' == 'Windows_NT'">true</IncludeNativeLibrariesForSelfExtract>
    <EnableSingleFileBundle Condition="'$(OS)' == 'Windows_NT'">true</EnableSingleFileBundle>
  </PropertyGroup>

  <!-- One toolkit, three backends. The backend packages are registered explicitly in Program and
       the ones that do not apply to the running platform are dropped again by the trimmer. -->
  <ItemGroup>
    <PackageReference Include="Hawkynt.NativeForms" Version="1.0.0.227" />
    <PackageReference Include="Hawkynt.NativeForms.Backends.Windows" Version="1.0.0.63" />
    <PackageReference Include="Hawkynt.NativeForms.Backends.Gtk" Version="1.0.0.73" />
    <PackageReference Include="Hawkynt.NativeForms.Backends.MacOS" Version="1.0.0.92" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Optimizers\Optimizer.Image\Optimizer.Image.csproj" />
    <ProjectReference Include="..\Hawkynt.FileFormats.Images\Hawkynt.FileFormats.Images.csproj" />
    <ProjectReference Include="..\FileFormat.Core\FileFormat.Core.csproj" />
  </ItemGroup>

  <Import Project="..\build\SingleFileBundle.targets" />

</Project>
