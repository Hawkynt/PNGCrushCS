<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Description>Unit tests for the video containers and codecs, one assembly for all of them.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit.Analyzers" Version="4.7.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Hawkynt.FileFormats.Video\Hawkynt.FileFormats.Video.csproj" />
    <!-- The frame comparisons decode the same JPEG on its own to check the container against, and the
         test JPEGs are written with the image package's own encoder. -->
    <!--
      Aliased on purpose. HEIF still pictures are H.265, so the H.265 core is compiled into the
      image assembly as well as the video one from a single source location. This project sees
      both sets of internals, so without an alias every one of those types is ambiguous here.
      Files that genuinely want something from the image assembly say so with extern alias.
    -->
    <ProjectReference Include="..\..\Hawkynt.FileFormats.Images\Hawkynt.FileFormats.Images.csproj"
                      Aliases="Images" />
    <ProjectReference Include="..\..\FileFormat.Core\FileFormat.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>
</Project>
