<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Description>Unit tests for every image format, one assembly for all of them.</Description>

    <!--
      Mirrors FileFormat.JpegXl's cross-repo source link so its #if CW_SIBLING smoke tests fire in
      lockstep with the code they exercise. Absent sibling, the define stays unset and those tests
      compile out.
    -->
    <CwSiblingPath>$(MSBuildThisFileDirectory)..\..\..\CompressionWorkbench\Compression.Core</CwSiblingPath>
    <CwSiblingPresent>false</CwSiblingPresent>
    <CwSiblingPresent Condition="Exists('$(CwSiblingPath)\Hawkynt.Compression.Core.csproj')">true</CwSiblingPresent>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CwSiblingPresent)' == 'true'">
    <DefineConstants>$(DefineConstants);CW_SIBLING</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit.Analyzers" Version="4.7.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
    <!-- The JPEG tests compare against GDI+ decoding; nothing else here needs it. -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Hawkynt.FileFormats.Images\Hawkynt.FileFormats.Images.csproj" />
    <ProjectReference Include="..\..\FileFormat.Core\FileFormat.Core.csproj" />
    <ProjectReference Include="..\..\FileFormat.TextMode\FileFormat.TextMode.csproj" />
    <ProjectReference Include="..\..\Compression.Core\Compression.Core.csproj" />
  </ItemGroup>

  <!-- BPG files libbpg's bpgenc wrote; the tests hold the hash of what libbpg decodes each to. -->
  <ItemGroup>
    <None Include="Formats\Bpg\Fixtures\*.bpg">
      <Link>BpgFixtures\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- JPEG XR files jxrlib's encoder wrote, each beside jxrlib's own decode of it in the file's
       native pixel format, so the managed decoder is measured against the reference byte for byte. -->
  <ItemGroup>
    <None Include="Formats\JpegXr\Fixtures\*.jxr;Formats\JpegXr\Fixtures\*.raw">
      <Link>JxrFixtures\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Small self-made PDFs and the poppler renders they are held to. Copied under Fixtures\Pdf\
       keeping their folders, so each stage of the renderer has its own set. -->
  <ItemGroup>
    <None Include="Formats\Pdf\Fixtures\**\*.*" Exclude="Formats\Pdf\Fixtures\**\*.py">
      <Link>Fixtures\Pdf\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Real JPEG XL files from libjxl's test corpus, validating our parsers against bitstreams a
       reference encoder produced rather than only against synthetic round-trips. -->
  <ItemGroup>
    <None Include="Formats\JpegXl\Fixtures\*.jxl">
      <!-- Linked to the output root: the tests look for Fixtures\ beside the assembly, which is
           where they sat when JPEG XL had a project of its own. -->
      <Link>Fixtures\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Small generated binary vectors may be stored as base64 text so the GitHub connector can
         add them without changing their bytes. Tests decode them before handing them to the reader. -->
    <None Include="Formats\JpegXl\Fixtures\*.b64">
      <Link>Fixtures\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- djxl's own decode of a fixture beside it, so a decode can be compared against libjxl
         rather than against this package's other half. -->
    <None Include="Formats\JpegXl\Fixtures\*.ppm">
      <Link>Fixtures\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- djxl's decode again, where the picture carries an alpha plane and a .ppm cannot hold it.
         A grey picture is a third the size this way too, which is what makes an animation's every
         moment affordable to keep. -->
    <None Include="Formats\JpegXl\Fixtures\*.pam">
      <Link>Fixtures\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- The blue-noise pattern libjxl adds to every eight-bit sample it writes. Comparing a lossy
         decode against one of those .ppm files means nothing without it. -->
    <None Include="Formats\JpegXl\Fixtures\*.txt">
      <Link>Fixtures\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- An Aseprite sprite written by ImageMagick, and the picture ImageMagick was given to write it
       from. The second is the reference because ImageMagick cannot read the sprite back. -->
  <ItemGroup>
    <None Include="Formats\Aseprite\Fixtures\*">
      <Link>Fixtures\Aseprite\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- An AVCI written from an x264 intra frame, and libheif's own decode of it. -->
  <ItemGroup>
    <None Include="Formats\Heif\Fixtures\*">
      <Link>Fixtures\Heif\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- H.265 range extension streams: JCT-VC conformance bitstreams and a few the HM reference
       encoder wrote, each with the MD5 the HM reference decoder's output has. -->
  <ItemGroup>
    <None Include="Codecs\H265\Fixtures\*">
      <Link>Fixtures\H265\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- A CR3 built to the layout ExifTool reads, carrying a preview and a thumbnail. -->
  <ItemGroup>
    <None Include="Formats\Cr3\Fixtures\*">
      <Link>Fixtures\Cr3\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Codestreams OpenJPEG wrote from the two .pnm pictures beside them, one per coding option
       worth exercising, plus its own decode of the irreversible one. -->
  <ItemGroup>
    <None Include="Formats\Jpeg2000\Fixtures\*">
      <Link>Fixtures\Jpeg2000\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- A DLL the Microsoft toolchain produced, and the .cur/.ico it was produced from, so the PE
       resource reader and writer can be held to what rc.exe and link.exe emit rather than to each
       other. See Formats\WindowsPe\Fixtures\oracle.rc for the exact command line. -->
  <ItemGroup>
    <None Include="Formats\WindowsPe\Fixtures\*">
      <Link>Fixtures\WindowsPe\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- JWIC files the translator's own coder wrote from the pictures beside them, and its decode of
       each. See Formats\Wic\Fixtures\README.txt. -->
  <ItemGroup>
    <None Include="Formats\Wic\Fixtures\*">
      <Link>Fixtures\Wic\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- IWC files this package's writer produced, and the WaveL applet's own decode of each. See
       Formats\Iwc\Fixtures\README.txt. -->
  <ItemGroup>
    <None Include="Formats\Iwc\Fixtures\*">
      <Link>Fixtures\Iwc\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Pictures made here, coded by the author's pwcencode and decoded by his pwcdecode, so the PWC reader
       and writer are held to the reference programs rather than to each other. See Fixtures\ORIGIN.txt. -->
  <ItemGroup>
    <None Include="Formats\Pwc\Fixtures\*">
      <Link>Fixtures\Pwc\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- LuraWave streams in every colour mode and layout, each beside what LuraTech's own Java
       decoder (lwf_jsdk2.6) decoded it to. See Formats\LuraWave\LuraWaveOracleTests.cs. -->
  <ItemGroup>
    <None Include="Formats\LuraWave\Fixtures\*">
      <Link>Fixtures\LuraWave\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- WhyPic pictures written by the reference encoder built from the distribution's source, the
       reference decoder's bitmaps of them, and the few this package's writer had to make because
       the reference encoder cannot. Fixtures\WhyPic\manifest.txt says which is which. -->
  <ItemGroup>
    <None Include="Formats\WhyPic\Fixtures\*">
      <Link>Fixtures\WhyPic\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- ERI pictures and animations written by the Entis libraries built from their published
       source, with their decodes, and this package's writer's files with the libraries' decodes of
       them. Fixtures\Eri\manifest.txt says which is which. -->
  <ItemGroup>
    <None Include="Formats\Eri\Fixtures\*">
      <Link>Fixtures\Eri\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Pick Ax pictures written by Smaller Animals' own PAXIO.dll and ImgSource 5, from the two
       pictures given beside them. See Formats\Pax\Fixtures\PROVENANCE.txt. -->
  <ItemGroup>
    <None Include="Formats\Pax\Fixtures\*">
      <Link>Fixtures\Pax\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Fractal images made for this suite, and Iterated's DECO_32.DLL decode of each. See
       Formats\Fif\Fixtures\PROVENANCE.txt. -->
  <ItemGroup>
    <None Include="Formats\Fif\Fixtures\*">
      <Link>Fixtures\Fif\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>
</Project>