<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Description>Unit tests for every image format, one assembly for all of them.</Description>

    <!--
      Mirrors FileFormat.JpegXl's cross-repo source link so its #if CW_SIBLING smoke tests fire in
      lockstep with the code they exercise. Absent sibling, the define stays unset and those tests
      compile out.
    -->
    <CwSiblingPath>$(MSBuildThisFileDirectory)..\..\..\CompressionWorkbench\Compression.Core</CwSiblingPath>
    <CwSiblingPresent>false</CwSiblingPresent>
    <CwSiblingPresent Condition="Exists('$(CwSiblingPath)\Hawkynt.Compression.Core.csproj')">true</CwSiblingPresent>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CwSiblingPresent)' == 'true'">
    <DefineConstants>$(DefineConstants);CW_SIBLING</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit.Analyzers" Version="4.7.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
    <!-- The JPEG tests compare against GDI+ decoding; nothing else here needs it. -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Hawkynt.FileFormats.Images\Hawkynt.FileFormats.Images.csproj" />
    <ProjectReference Include="..\..\FileFormat.Core\FileFormat.Core.csproj" />
    <ProjectReference Include="..\..\FileFormat.TextMode\FileFormat.TextMode.csproj" />
    <ProjectReference Include="..\..\Compression.Core\Compression.Core.csproj" />
  </ItemGroup>

  <!-- Real JPEG XL files from libjxl's test corpus, validating our parsers against bitstreams a
       reference encoder produced rather than only against synthetic round-trips. -->
  <ItemGroup>
    <None Include="Formats\JpegXl\Fixtures\*.jxl">
      <!-- Linked to the output root: the tests look for Fixtures\ beside the assembly, which is
           where they sat when JPEG XL had a project of its own. -->
      <Link>Fixtures\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- djxl's own decode of a fixture beside it, so a decode can be compared against libjxl
         rather than against this package's other half. -->
    <None Include="Formats\JpegXl\Fixtures\*.ppm">
      <Link>Fixtures\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- The blue-noise pattern libjxl adds to every eight-bit sample it writes. Comparing a lossy
         decode against one of those .ppm files means nothing without it. -->
    <None Include="Formats\JpegXl\Fixtures\*.txt">
      <Link>Fixtures\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- An Aseprite sprite written by ImageMagick, and the picture ImageMagick was given to write it
       from. The second is the reference because ImageMagick cannot read the sprite back. -->
  <ItemGroup>
    <None Include="Formats\Aseprite\Fixtures\*">
      <Link>Fixtures\Aseprite\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- An AVCI written from an x264 intra frame, and libheif's own decode of it. -->
  <ItemGroup>
    <None Include="Formats\Heif\Fixtures\*">
      <Link>Fixtures\Heif\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- A CR3 built to the layout ExifTool reads, carrying a preview and a thumbnail. -->
  <ItemGroup>
    <None Include="Formats\Cr3\Fixtures\*">
      <Link>Fixtures\Cr3\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Codestreams OpenJPEG wrote from the two .pnm pictures beside them, one per coding option
       worth exercising, plus its own decode of the irreversible one. -->
  <ItemGroup>
    <None Include="Formats\Jpeg2000\Fixtures\*">
      <Link>Fixtures\Jpeg2000\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>
</Project>
