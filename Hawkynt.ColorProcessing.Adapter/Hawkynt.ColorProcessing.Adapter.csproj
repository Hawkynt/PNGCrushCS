<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <Description>Runs the FrameworkExtensions quantizers and ditherers on a RawImage, so they work off Windows.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileFormat.Core\FileFormat.Core.csproj" />
  </ItemGroup>

  <!-- The package's netcoreapp3.1 asset carries the whole of Hawkynt.ColorProcessing and is not
       tied to Windows; only its Bitmap glue is, and this project replaces that. Referencing the
       assembly directly rather than the package avoids the package's own windows-only target
       framework, which would force the whole build back onto Windows. -->
  <ItemGroup>
    <Reference Include="System.Drawing.Extensions">
      <HintPath>$(NuGetPackageRoot)frameworkextensions.system.drawing/1.0.1.1347/lib/netcoreapp3.1/System.Drawing.Extensions.dll</HintPath>
      <Private>true</Private>
    </Reference>

    <!-- The netcoreapp3.1 asset of Backports, not the net8.0 one. The colour library was compiled
         against the older target, where the polyfills its inner loops call are real types; on a
         modern runtime those APIs exist in the framework, so that build of Backports drops them and
         the calls fail to bind at run time. Pinning the asset keeps the two in step. -->
    <Reference Include="Backports">
      <HintPath>$(NuGetPackageRoot)frameworkextensions.backports/1.0.0.1347/lib/netcoreapp3.1/Backports.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
