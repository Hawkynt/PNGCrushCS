<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Shared infrastructure for text-mode image formats: TextCell/TextScreen model, CP437 lookup, embedded VGA-style 8x16 bitmap font, render + quantize helpers.</Description>
    <!-- Multi-target so Hawkynt.ImageTransformUI (net48/net8.0-windows/net10.0-windows) can reference us. -->
    <TargetFramework />
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FileFormat.Nfo" />
    <InternalsVisibleTo Include="FileFormat.AnsiArt" />
    <InternalsVisibleTo Include="FileFormat.XBin" />
    <InternalsVisibleTo Include="FileFormat.Nfo.Tests" />
    <InternalsVisibleTo Include="FileFormat.AnsiArt.Tests" />
    <InternalsVisibleTo Include="FileFormat.XBin.Tests" />
    <InternalsVisibleTo Include="FileFormat.TextMode.Tests" />
  </ItemGroup>

  <!-- Intentionally no FileFormat.Core reference: this lib is consumed by Hawkynt.ImageTransformUI
       (which targets net48 too) and stays platform-neutral. Format files (NFO/ANSI/XBIN) bridge
       to RawImage in their own assemblies. -->

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <!-- Span<T> + Memory<T> for the legacy target. -->
    <PackageReference Include="System.Memory" Version="4.5.5" />
  </ItemGroup>

  <!-- Era font catalogue: deflate-compressed glyph blobs baked by Tools/FontBaker.
       LogicalName strips the path prefix so BitmapFontEmbedded._Load can find them by bare filename. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Fonts\*.fnt.dfl">
      <LogicalName>%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
