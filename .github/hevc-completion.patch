+    w.WriteUe(0);
+    w.WriteUe(type == H265SliceType.B ? 0u : 1u);
+    w.WriteBits((uint)poc, 8);
+    w.WriteBit(0);
+    w.WriteUe((uint)pastPocs.Count);
+    w.WriteUe(futurePoc.HasValue ? 1u : 0u);
