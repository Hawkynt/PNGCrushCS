<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <RootNamespace>Hawkynt.FileFormats.Images</RootNamespace>
    <AssemblyName>Hawkynt.FileFormats.Images</AssemblyName>

    <!-- Tells the source generator to emit `ImageFormat` and `FormatRegistration` into our namespace. -->
    <FileFormatRegistryNamespace>Hawkynt.FileFormats.Images</FileFormatRegistryNamespace>

    <!-- NuGet packaging metadata -->
    <PackageId>Hawkynt.FileFormats.Images</PackageId>
    <!-- Last digit is auto-stamped at CI time by version.pl in stamp mode (matches the convention
         used by every other csproj in the repo): MAJOR.MINOR.PATCH here, .BUILD appended at pack. -->
    <Version>1.0.0</Version>
    <Authors>Hawkynt</Authors>
    <Description>Comprehensive pure-C# library for reading, writing, and detecting image file formats. Bundles format implementations (PNG, JPEG, GIF, BMP, TIFF, WebP, etc.) behind a single zero-reflection registry with magic-byte detection, MIME-type lookup, and stream-based detection.</Description>
    <PackageTags>image;file-format;png;jpeg;gif;bmp;tiff;webp;codec;decoder;encoder;mime;detection</PackageTags>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Hawkynt/PNGCrushCS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>true</IncludeBuildOutput>

    <!-- Bundle the referenced support libraries into the package's lib/ folder. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddAllReferencedAssembliesToPackage</TargetsForTfmSpecificContentInPackage>

    <!--
      Cross-repo source linking from the sibling CompressionWorkbench checkout, for the JPEG XL
      codec. We link individual .cs files (BitIO, Huffman, …) instead of taking a
      <ProjectReference> because CompressionWorkbench transitively references this repo's
      Hawkynt.FileFormats.Images, which would create a build cycle. When the sibling is absent the
      linked files are skipped and the CW_SIBLING define stays unset, so dependent code paths
      compile out via #if CW_SIBLING. CI clones the sibling at the parallel path; consumers
      installing the published NuGet do not need it.
    -->
    <CwSiblingPath>$(MSBuildThisFileDirectory)..\..\CompressionWorkbench\Compression.Core</CwSiblingPath>
    <CwSiblingPresent>false</CwSiblingPresent>
    <CwSiblingPresent Condition="Exists('$(CwSiblingPath)\Hawkynt.Compression.Core.csproj')">true</CwSiblingPresent>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CwSiblingPresent)' == 'true'">
    <DefineConstants>$(DefineConstants);CW_SIBLING</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(CwSiblingPresent)' == 'true'">
    <!-- The CW sources assume ImplicitUsings; we have it disabled, so add the minimum global
         usings their linked files need at project scope. -->
    <Using Include="System" />
    <Using Include="System.IO" />
    <!-- Bit-level I/O primitives: 6 files, dep-free, only system usings. Provides
         Compression.Core.BitIO.{BitReader, BitWriter, BitBuffer, BitOrder, IBitOrder,
         BitHelpers}. -->
    <Compile Include="$(CwSiblingPath)\BitIO\*.cs" LinkBase="External\Cw\BitIO" />
    <!-- Canonical Huffman primitives. We avoid HuffmanTree (depends on
         Compression.Core.DataStructures) and HuffmanBuildingBlock (depends on
         Compression.Registry) — only the dep-free pieces link cleanly. -->
    <Compile Include="$(CwSiblingPath)\Entropy\Huffman\CanonicalCodeAssigner.cs" LinkBase="External\Cw\Entropy\Huffman" />
    <Compile Include="$(CwSiblingPath)\Entropy\Huffman\CanonicalHuffman.cs" LinkBase="External\Cw\Entropy\Huffman" />
    <Compile Include="$(CwSiblingPath)\Entropy\Huffman\HuffmanDecoder.cs" LinkBase="External\Cw\Entropy\Huffman" />
    <Compile Include="$(CwSiblingPath)\Entropy\Huffman\HuffmanEncoder.cs" LinkBase="External\Cw\Entropy\Huffman" />
    <Compile Include="$(CwSiblingPath)\Entropy\Huffman\HuffmanNode.cs" LinkBase="External\Cw\Entropy\Huffman" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- Expose <FileFormatRegistryNamespace> to the source generator's AnalyzerConfigOptions. -->
    <CompilerVisibleProperty Include="FileFormatRegistryNamespace" />
  </ItemGroup>

  <!-- Every format used to be its own assembly and granted its own test project access to its
       internals. The formats now share this one assembly, so the grants are reissued from here,
       derived from the projects on disk rather than listed by hand. -->
  <ItemGroup>
    <_InternalsConsumer Include="..\Tests\*\*.csproj" />
    <_InternalsConsumer Include="..\Optimizers\*\*.csproj" />
    <InternalsVisibleTo Include="@(_InternalsConsumer->'%(Filename)'->Distinct())" />
    <!--
      The video package's Motion JPEG splitter needs JpegChunkLayout.FirstImageLength. Splitting a
      stream by searching for FF D9 cuts frames in half — entropy-coded data contains those bytes and
      a thumbnail is a whole second JPEG with an end marker of its own — so it has to be the same
      marker walk the JPEG optimizer uses, and that walk stays in one place rather than being copied
      into a second assembly.
    -->
    <InternalsVisibleTo Include="Hawkynt.FileFormats.Video" />
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets="all" prevents these from showing up as broken NuGet dependencies
         (they don't ship as standalone packages on nuget.org). Consumers see all types via
         the bundled DLLs in lib/$(TargetFramework). -->
    <ProjectReference Include="..\FileFormat.Core\FileFormat.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Compression.Core\Compression.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\FileFormat.TextMode\FileFormat.TextMode.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\FileFormat.Core.Generators\FileFormat.Core.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <ProjectReference Include="..\FileFormat.Registry.Generator\FileFormat.Registry.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <!-- External packages the format sources under Formats\ depend on at runtime. These flow as
       transitive dependencies of the package, which is the correct behavior — consumers get them
       installed automatically. -->
  <ItemGroup>
    <PackageReference Include="BitMiracle.LibTiff.NET" Version="2.4.649" />
    <PackageReference Include="BitMiracle.LibJpeg.NET" Version="1.5.324" />
    <PackageReference Include="FrameworkExtensions.Backports" Version="1.0.0.256" />
    <!-- 10.0.3, not the 9.0.4 the PNG-family projects used to pin: FrameworkExtensions.Backports
         now sits in the same graph and requires it, and a downgrade is an error here. -->
    <PackageReference Include="System.IO.Hashing" Version="10.0.3" />
  </ItemGroup>

  <!-- Bundle every referenced project assembly into lib/<tfm>/ at pack time. Walks the build's
       ReferencePath items (each ProjectReference resolves to a ReferencePath after build) and adds
       the resolved .dll as a packed file, so FileFormat.Core, Compression.Core and
       FileFormat.TextMode ship inside the package instead of as missing dependencies. -->
  <Target Name="_AddAllReferencedAssembliesToPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <_BundledRefs Include="@(ReferencePath)"
                    Condition="'%(ReferencePath.ReferenceSourceTarget)' == 'ProjectReference' and '%(ReferencePath.Extension)' == '.dll'" />
      <TfmSpecificPackageFile Include="@(_BundledRefs)" PackagePath="lib/$(TargetFramework)" />
    </ItemGroup>
    <Message Importance="high" Text="Bundling @(_BundledRefs->Count()) referenced project DLLs into lib/$(TargetFramework)" />
  </Target>

</Project>
