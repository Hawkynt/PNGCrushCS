<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <RootNamespace>Hawkynt.FileFormats.Images</RootNamespace>
    <AssemblyName>Hawkynt.FileFormats.Images</AssemblyName>

    <!-- Tells the source generator to emit `ImageFormat` and `FormatRegistration` into our namespace. -->
    <FileFormatRegistryNamespace>Hawkynt.FileFormats.Images</FileFormatRegistryNamespace>

    <!-- NuGet packaging metadata -->
    <PackageId>Hawkynt.FileFormats.Images</PackageId>
    <!-- Last digit is auto-stamped at CI time by version.pl in stamp mode (matches the convention
         used by every other csproj in the repo): MAJOR.MINOR.PATCH here, .BUILD appended at pack. -->
    <Version>1.0.0</Version>
    <Authors>Hawkynt</Authors>
    <Description>Comprehensive pure-C# library for reading, writing, and detecting image file formats. Bundles format implementations (PNG, JPEG, GIF, BMP, TIFF, WebP, etc.) behind a single zero-reflection registry with magic-byte detection, MIME-type lookup, and stream-based detection.</Description>
    <PackageTags>image;file-format;png;jpeg;gif;bmp;tiff;webp;codec;decoder;encoder;mime;detection</PackageTags>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Hawkynt/PNGCrushCS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>true</IncludeBuildOutput>

    <!-- Bundle every transitively-referenced format DLL into the package's lib/ folder. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddAllReferencedAssembliesToPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- Expose <FileFormatRegistryNamespace> to the source generator's AnalyzerConfigOptions. -->
    <CompilerVisibleProperty Include="FileFormatRegistryNamespace" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Optimizer.Image" />
    <InternalsVisibleTo Include="Hawkynt.FileFormats.Images.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets="all" prevents these from showing up as broken NuGet dependencies
         (the FileFormat.* projects don't ship as standalone packages on nuget.org).
         Consumers see all types via the bundled DLLs in lib/$(TargetFramework). -->
    <ProjectReference Include="..\FileFormat.Core\FileFormat.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\FileFormat.Registry.Generator\FileFormat.Registry.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <!-- Pull in every FileFormat.<Name> library via wildcard so the source generator sees them.
       Format adapters live under ..\FileFormats\; Core / Registry.Generator stay at repo root. -->
  <ItemGroup>
    <ProjectReference Include="..\FileFormats\FileFormat.*\FileFormat.*.csproj"
                      PrivateAssets="all" />
  </ItemGroup>

  <!-- External NuGet packages that bundled FileFormat.* libraries depend on at runtime.
       PrivateAssets="all" on the FileFormat.* refs above also hides their transitive
       PackageReferences from this package's nuspec, so we re-declare them explicitly here.
       These flow as transitive dependencies of the meta-package, which is the correct
       behavior — consumers get them installed automatically. -->
  <ItemGroup>
    <PackageReference Include="BitMiracle.LibTiff.NET" Version="2.4.649" />
    <PackageReference Include="BitMiracle.LibJpeg.NET" Version="1.5.324" />
    <PackageReference Include="FrameworkExtensions.Backports" Version="1.0.0.256" />
  </ItemGroup>

  <!-- Bundle every transitively-referenced project assembly into lib/<tfm>/ at pack time.
       Walks the build's ReferencePath items (each ProjectReference resolves to a ReferencePath
       after build) and adds the resolved .dll as a packed file. -->
  <Target Name="_AddAllReferencedAssembliesToPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <_BundledRefs Include="@(ReferencePath)"
                    Condition="'%(ReferencePath.ReferenceSourceTarget)' == 'ProjectReference' and '%(ReferencePath.Extension)' == '.dll'" />
      <TfmSpecificPackageFile Include="@(_BundledRefs)" PackagePath="lib/$(TargetFramework)" />
    </ItemGroup>
    <Message Importance="high" Text="Bundling @(_BundledRefs->Count()) referenced project DLLs into lib/$(TargetFramework)" />
  </Target>

  <!-- Strip FileFormat.* ProjectReferences from the generated nuspec's <dependencies> list.
       We need MSBuild's project graph to flow them (so direct types like FileFormat.Apng.ApngFile
       are visible to ProjectReference consumers of this package), but NuGet would otherwise
       turn each one into a non-existent <dependency id="FileFormat.X" version="1.0.0" /> entry.
       Their DLLs are bundled in lib/ via _AddAllReferencedAssembliesToPackage above; their
       transitive PackageReferences (BitMiracle.LibTiff.NET, BitMiracle.LibJpeg.NET,
       FrameworkExtensions.Backports, etc.) propagate naturally and remain in the nuspec. -->
</Project>
