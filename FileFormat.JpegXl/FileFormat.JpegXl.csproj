<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Pure C# JPEG XL (ISO/IEC 18181) container reader and writer.</Description>

    <!--
      Cross-repo source linking from the sibling CompressionWorkbench checkout.
      We link individual .cs files (BitIO, Huffman, …) instead of taking a
      <ProjectReference> because CompressionWorkbench transitively references
      this repo's Hawkynt.FileFormats.Images, which would create a build cycle.
      When the sibling is absent the linked files are skipped and the
      CW_SIBLING define stays unset, so dependent code paths compile out
      via #if CW_SIBLING. CI clones the sibling at the parallel path; consumers
      installing the published NuGet do not need it.
    -->
    <CwSiblingPath>$(MSBuildThisFileDirectory)..\..\CompressionWorkbench\Compression.Core</CwSiblingPath>
    <CwSiblingPresent>false</CwSiblingPresent>
    <CwSiblingPresent Condition="Exists('$(CwSiblingPath)\Hawkynt.Compression.Core.csproj')">true</CwSiblingPresent>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FileFormat.JpegXl.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FileFormat.Core\FileFormat.Core.csproj" />
  </ItemGroup>

  <!-- ============================================================
       CompressionWorkbench source-linked compression building blocks.
       Conditional on the sibling repo being checked out at ..\..\CompressionWorkbench.
       The linked types live under namespace Compression.Core.* and are accessible
       via `#if CW_SIBLING using Compression.Core...;` inside the JXL codec files.
       ============================================================ -->
  <PropertyGroup Condition="'$(CwSiblingPresent)' == 'true'">
    <DefineConstants>$(DefineConstants);CW_SIBLING</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(CwSiblingPresent)' == 'true'">
    <!-- The CW sources assume ImplicitUsings; we have it disabled, so add the
         minimum global usings their linked files need at project scope. -->
    <Using Include="System" />
    <Using Include="System.IO" />
    <!-- Bit-level I/O primitives: 6 files, dep-free, only system usings.
         Provides Compression.Core.BitIO.{BitReader, BitWriter, BitBuffer,
         BitOrder, IBitOrder, BitHelpers}. Useful for a future second
         implementation of JxlBitReader that streams from a Stream rather
         than buffering a byte array. -->
    <Compile Include="$(CwSiblingPath)\BitIO\*.cs" LinkBase="External\Cw\BitIO" />
    <!-- Canonical Huffman primitives. We avoid HuffmanTree (depends on
         Compression.Core.DataStructures) and HuffmanBuildingBlock (depends on
         Compression.Registry) — only the dep-free pieces link cleanly. -->
    <Compile Include="$(CwSiblingPath)\Entropy\Huffman\CanonicalCodeAssigner.cs" LinkBase="External\Cw\Entropy\Huffman" />
    <Compile Include="$(CwSiblingPath)\Entropy\Huffman\CanonicalHuffman.cs" LinkBase="External\Cw\Entropy\Huffman" />
    <Compile Include="$(CwSiblingPath)\Entropy\Huffman\HuffmanDecoder.cs" LinkBase="External\Cw\Entropy\Huffman" />
    <Compile Include="$(CwSiblingPath)\Entropy\Huffman\HuffmanEncoder.cs" LinkBase="External\Cw\Entropy\Huffman" />
    <Compile Include="$(CwSiblingPath)\Entropy\Huffman\HuffmanNode.cs" LinkBase="External\Cw\Entropy\Huffman" />
  </ItemGroup>
</Project>
