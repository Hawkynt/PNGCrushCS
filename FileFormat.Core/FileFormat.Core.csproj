<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <Version>1.0.0.22</Version>
    <Authors>Hawkynt</Authors>
    <Description>Shared types for file format header field descriptors.</Description>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FileFormat.Core.Generators\FileFormat.Core.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- Character generator ROMs. A handful of formats store nothing but character codes and are
         undecodable without the font the machine drew them with. -->
    <EmbeddedResource Include="Roms\atari8.fnt" LogicalName="FileFormat.Core.Roms.atari8.fnt" />
    <EmbeddedResource Include="Roms\zx81.fnt" LogicalName="FileFormat.Core.Roms.zx81.fnt" />
  </ItemGroup>
</Project>
