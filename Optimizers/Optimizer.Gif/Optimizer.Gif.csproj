<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>

    <Description>GIF optimization engine with palette reordering, LZW re-encoding, and frame optimization.</Description>
    <PackageReadmeFile>ReadMe.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Hawkynt/PNGCrushCS</PackageProjectUrl>
    <PackageTags>GifOptimizer;ImageCrush;Hawkynt</PackageTags>
    <RepositoryUrl>https://github.com/Hawkynt/PNGCrushCS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <None Include="ReadMe.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="Optimizer.Gif.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Hawkynt.FileFormats.Images\Hawkynt.FileFormats.Images.csproj" />
    <ProjectReference Include="..\..\FileFormat.Core\FileFormat.Core.csproj" />
    <ProjectReference Include="../../Crush.Core/Crush.Core.csproj" />
  </ItemGroup>

</Project>
